# VeritasAI Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Required API Keys
# ============================================

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ============================================
# Optional API Keys
# ============================================

# SerpAPI Key (for real web search)
# Get yours at: https://serpapi.com/
# Leave empty to use mock web search
SERPAPI_API_KEY=
TAVILY_API_KEY=
# ============================================
# System Configuration
# ============================================

# Enable/Disable LLM Evidence Reranking
# Set to "true" to enable (uses API quota)
# Set to "false" to disable (faster, no API cost)
ENABLE_RERANKING=false

# ============================================
# Model Configuration
# ============================================

# Primary LLM Model
# Options: gemini-2.0-flash-exp, gemini-2.5-flash, gemini-pro
LLM_MODEL=gemini-2.5-flash

# Embedding Model (local)
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Temperature (0.0 - 1.0)
# Lower = more deterministic, Higher = more creative
LLM_TEMPERATURE=0.0

# ============================================
# Retrieval Configuration
# ============================================

# Vector Store Top K
VECTOR_STORE_TOP_K=5

# Web Search Top K
WEB_SEARCH_TOP_K=5

# Final Top K (after reranking)
FINAL_TOP_K=3

# Minimum Relevance Score (0.0 - 1.0)
MIN_RELEVANCE_SCORE=0.3

# ============================================
# Frontend Configuration
# ============================================

# Streamlit Theme
# Options: light, dark
STREAMLIT_THEME=light

# Default Analysis Mode
# Options: text, image, multimodal
DEFAULT_MODE=text

# ============================================
# Development & Debugging
# ============================================

# Debug Mode
# Set to "true" for verbose logging
DEBUG=false

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
